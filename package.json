{
  "name": "neurotrackai",
  "version": "1.0.0",
  "private": true,
  "description": "Multimodal AI-powered early neurological screening (voice, face, hand, gait)",
  "scripts": {
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "dev": "concurrently -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:all": "concurrently -n ml,server,client -c green,magenta,cyan \"npm:dev:ml\" \"npm:dev:server\" \"npm:dev:client\"",
    "dev:ml": "python ml-service/run.py",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "docker:up": "docker-compose up --build",
    "docker:down": "docker-compose down",
    "seed": "npm --prefix server run seed",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "validate": "npm --prefix server run validate"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
