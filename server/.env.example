# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---- Database ----
# Local MongoDB (already running as a Windows service on your machine)
MONGODB_URI=mongodb://127.0.0.1:27017/neurotrackai
# Or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/neurotrackai

# ---- Auth ----
# Change these to long random strings before deploying.
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_REFRESH_SECRET=change_me_too_another_long_random_string_32c
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ---- Assessment schedule ----
ASSESSMENT_INTERVAL_DAYS=7

# ---- Email reminders (OPTIONAL) ----
# Leave SMTP_HOST empty to disable email entirely; the app works fine without it.
# For Gmail use an App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="NeuroTrackAI <no-reply@neurotrackai.local>"

# Weekly reminder cron (default: every Monday 09:00 server time)
REMINDER_CRON=0 9 * * 1
ENABLE_CRON=true
